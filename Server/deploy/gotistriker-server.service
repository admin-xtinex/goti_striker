[Unit]
Description=Goti Striker multiplayer server
Documentation=https://github.com/admin-xtinex/goti_striker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gotistriker
Group=gotistriker
WorkingDirectory=/opt/gotistriker
ExecStart=/opt/gotistriker/GotiStrikerServer

# Restart on crash. The server holds live matches, so come back fast.
Restart=always
RestartSec=3

# e2-micro has 1 GB total. Cap the service so a leak can't take the box down;
# the server is a relay + turn arbiter now (no physics), so this is generous.
MemoryMax=512M

# Hardening: the process only needs to read its own directory and bind a port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/gotistriker

# Logs go to journald: journalctl -u gotistriker-server -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gotistriker

Environment=PORT=7777
Environment=HOST=0.0.0.0
Environment=ENVIRONMENT=Production
Environment=LOG_LEVEL=Info

[Install]
WantedBy=multi-user.target
